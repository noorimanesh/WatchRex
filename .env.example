APP_NAME=WatchRex
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://watch.example.com

# fa = Persian (RTL, Jalali dates) · en = English. Users can change it in their profile.
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# SQLite is fine for small installs; use MySQL/MariaDB/PostgreSQL for hundreds of monitors.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=watchrex
# DB_USERNAME=watchrex
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database queue works everywhere; redis is faster on busy installs.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Used for e-mail alerts.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="watchrex@example.com"
MAIL_FROM_NAME="WatchRex"

# Reverse proxies whose X-Forwarded-* headers are trusted (comma separated, or * behind Cloudflare/LB).
TRUSTED_PROXIES=127.0.0.1

# ── WatchRex ───────────────────────────────────────────────────────────────
WATCHREX_LOCATION=ir-tehran
WATCHREX_CHECK_QUEUE=checks
WATCHREX_ALERT_QUEUE=alerts
WATCHREX_DOMAIN_QUEUE=default
WATCHREX_DEFAULT_PLAN=pro
WATCHREX_HEARTBEAT_DAYS=30
WATCHREX_METRIC_DAYS=14
WATCHREX_DAILY_STATS_DAYS=400
WATCHREX_AUDIT_DAYS=180
WATCHREX_DOMAIN_REFRESH_HOURS=6
WATCHREX_MAX_SUBDOMAINS=60
WATCHREX_SUBDOMAIN_SSL_CHECKS=25
WATCHREX_GEOIP_URL="https://ipwho.is/{ip}"
# Block tenant monitors that target private/internal networks (SSRF). Admins are exempt.
WATCHREX_BLOCK_PRIVATE_TARGETS=true
WATCHREX_CSP=true
WATCHREX_HSTS=true

# ── Multi-location ─────────────────────────────────────────────────────────
WATCHREX_LOCATION_LABEL="Tehran"
WATCHREX_LOCATION_COUNTRY=IR
# Only on a remote probe install (run: php artisan watchrex:probe):
# WATCHREX_HUB_URL=https://watch.example.com
# WATCHREX_PROBE_TOKEN=wrx_probe_…
# WATCHREX_PROBE_CONCURRENCY=4

# ── Visual change detection (optional) ─────────────────────────────────────
# WATCHREX_CHROME_PATH=/usr/bin/chromium
# WATCHREX_SCREENSHOTS_FOR_TENANTS=false

# ── Single sign-on (OpenID Connect) ────────────────────────────────────────
OIDC_ENABLED=false
OIDC_LABEL="Fabapars SSO"
OIDC_ISSUER=https://sso.example.com/realms/fabapars
OIDC_CLIENT_ID=watchrex
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid email profile"
OIDC_AUTO_CREATE=false
OIDC_ALLOWED_DOMAINS=fabapars.com
OIDC_DEFAULT_ROLE=user
OIDC_DISABLE_PASSWORD_LOGIN=false

# ── SaaS billing (Zarinpal) ────────────────────────────────────────────────
WATCHREX_BILLING=false
WATCHREX_PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
WATCHREX_PRICE_PRO=290000
WATCHREX_PRICE_BUSINESS=1490000
WATCHREX_VAT_PERCENT=10
WATCHREX_BILLING_GRACE_DAYS=3
WATCHREX_SELLER_NAME="Fabapars"
WATCHREX_SELLER_ADDRESS=
WATCHREX_SELLER_NATIONAL_ID=
WATCHREX_SELLER_ECONOMIC_CODE=
