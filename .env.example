APP_NAME=WatchRex
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://watch.example.com

# fa = Persian (RTL, Jalali dates) · en = English. Users can change it in their profile.
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# SQLite is fine for small installs; use MySQL/MariaDB/PostgreSQL for hundreds of monitors.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=watchrex
# DB_USERNAME=watchrex
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database queue works everywhere; redis is faster on busy installs.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Used for e-mail alerts.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="watchrex@example.com"
MAIL_FROM_NAME="WatchRex"

# Reverse proxies whose X-Forwarded-* headers are trusted (comma separated, or * behind Cloudflare/LB).
TRUSTED_PROXIES=127.0.0.1

# ── WatchRex ───────────────────────────────────────────────────────────────
WATCHREX_LOCATION=iran-tehran
WATCHREX_CHECK_QUEUE=checks
WATCHREX_ALERT_QUEUE=alerts
WATCHREX_DOMAIN_QUEUE=default
WATCHREX_DEFAULT_PLAN=pro
WATCHREX_HEARTBEAT_DAYS=30
WATCHREX_METRIC_DAYS=14
WATCHREX_DAILY_STATS_DAYS=400
WATCHREX_AUDIT_DAYS=180
WATCHREX_DOMAIN_REFRESH_HOURS=6
WATCHREX_MAX_SUBDOMAINS=60
WATCHREX_SUBDOMAIN_SSL_CHECKS=25
WATCHREX_GEOIP_URL="https://ipwho.is/{ip}"
# Block tenant monitors that target private/internal networks (SSRF). Admins are exempt.
WATCHREX_BLOCK_PRIVATE_TARGETS=true
WATCHREX_CSP=true
WATCHREX_HSTS=true
